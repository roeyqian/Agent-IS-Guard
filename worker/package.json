{
  "name": "shopguard-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:view": "npm --prefix ../view run build",
    "deploy": "npm run build:view && wrangler deploy",
    "db:init": "wrangler d1 execute zero-1-base --file=src/migrations/0001_init.sql --remote",
    "db:seed": "wrangler d1 execute zero-1-base --file=src/migrations/0002_seed.sql --remote",
    "db:events": "wrangler d1 execute zero-1-base --file=src/migrations/0003_order_events.sql --remote",
    "db:i18n": "wrangler d1 execute zero-1-base --file=src/migrations/0004_product_i18n.sql --remote"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
